# Copy to .env.local (git-ignored) for local development.
# In GitHub, set these as repository *variables*: Settings → Secrets and variables → Actions → Variables.
# Leave everything empty to use the built-in demo events.

# --- Option A: iCal sync (build time) ---
# Public iCal address; on GitHub this enables the scheduled sync. Locally run:
#   ICAL_URL=<url> npm run sync:ical   and then set VITE_ICAL_SNAPSHOT=true below.
ICAL_URL=
VITE_ICAL_SNAPSHOT=

# --- Option B: Google Calendar API (live, from the browser) ---

# Public Google Calendar ID (Calendar settings → Integrate calendar → Calendar ID)
VITE_GOOGLE_CALENDAR_ID=
# Browser API key restricted to "Google Calendar API" + your website referrers
VITE_GOOGLE_API_KEY=
# --- Both ---
# auto (default: every configured source, API first) | ical | google-api | demo
VITE_EVENT_SOURCE=
# IANA time zone of the store's calendar (default: Europe/Warsaw)
VITE_TIME_ZONE=
# UI language (default: pl-PL; a host page can override it with ?lang=en)
VITE_LOCALE=

# --- Tournament defaults ---
# Seats shown when an event description has no valid "seats:" line (default: 12)
VITE_DEFAULT_SEATS=
# Store name and address, used when an event has no location (directions link)
VITE_DEFAULT_LOCATION=
