# Copy to .env.local (git-ignored) for local development.
# In GitHub, set these as repository *variables*: Settings → Secrets and variables → Actions → Variables.
# Leave empty to use the built-in demo events.

# Public Google Calendar ID (Calendar settings → Integrate calendar → Calendar ID)
VITE_GOOGLE_CALENDAR_ID=
# Browser API key restricted to "Google Calendar API" + your website referrers
VITE_GOOGLE_API_KEY=
# Optional IANA time zone for event days/times (default: the viewer's time zone)
VITE_TIME_ZONE=
